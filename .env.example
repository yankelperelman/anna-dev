# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# Optional. Your own Gemini API key (https://aistudio.google.com/app/apikey).
# You can instead enter the key on the web page; a key saved there takes priority.
GOOGLE_API_KEY=

# Optional. Default Gemini Live model (you can pick another one on the web page)
GEMINI_MODEL=gemini-3.8-live

# Optional. Default voice (you can pick another one on the web page)
ANNA_VOICE=Puck

# Optional. Server address. Keep 127.0.0.1 unless you know what you are doing:
# the WebSocket endpoint has no authentication.
ANNA_HOST=127.0.0.1
ANNA_PORT=8010

# Optional. Where a key entered on the web page is stored
ANNA_KEY_FILE=gemini_key.txt

# Optional. Where the local conversation log (SQLite) is stored
ANNA_DB_PATH=anna_history.sqlite3

# Optional. Only needed for the Telegram message tool
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Disk reported by the server monitoring skill
ANNA_MONITOR_DISK_PATH=/

# Optional. Region for web search results (wt-wt = no regional bias, e.g. ru-ru, us-en)
ANNA_SEARCH_REGION=wt-wt

# Optional but REQUIRED if the server is reachable from the internet (e.g. behind your domain).
# Choose a long random string. Open https://your-domain/?token=THAT_STRING once per browser;
# the page and the API then work only for browsers holding that cookie.
ANNA_ACCESS_TOKEN=

# Optional. Your domain(s) if you run behind a reverse proxy that rewrites the Host header
# (comma separated, no scheme), e.g. anna.example.org
ANNA_ALLOWED_HOSTS=
